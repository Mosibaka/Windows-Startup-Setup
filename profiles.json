  "Tweaks": {
    "UltimatePerformance": {
      "Names": {
        "RU": "План максимальной производительности (Power)",
        "EN": "Ultimate Performance power plan"
      },
      "Enabled": true,
      "Action": "powercfg"
    },
    "DisableTelemetry": {
      "Names": {
        "RU": "Отключение телеметрии и сбора данных",
        "EN": "Disable Windows telemetry"
      },
      "Enabled": true,
      "Action": "registry",
      "Path": "HKLM\\SOFTWARE\\Policies\\Microsoft\\Windows\\DataCollection",
      "Name": "AllowTelemetry",
      "Type": "REG_DWORD",
      "Value": "0"
    },
    "DisableXboxGameBar": {
      "Names": {
        "RU": "Отключение Xbox Game Bar",
        "EN": "Disable Xbox Game Bar"
      },
      "Enabled": false,
      "Action": "registry",
      "Path": "HKCU\\SOFTWARE\\Microsoft\\Windows\\CurrentVersion\\GameDVR",
      "Name": "AppCaptureEnabled",
      "Type": "REG_DWORD",
      "Value": "0"
    }
  },
